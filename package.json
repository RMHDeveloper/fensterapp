{
  "name": "fencraft-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:setup": "node --env-file=.env.local scripts/setup-supabase.mjs",
    "db:setup-production-table": "node --env-file=.env.local scripts/setup-production-table.mjs",
    "db:setup-files-table": "node --env-file=.env.local scripts/setup-files-table.mjs",
    "db:setup-dashboard-targets-table": "node --env-file=.env.local scripts/setup-dashboard-targets-table.mjs",
    "db:auth-migration": "node --env-file=.env.local scripts/run-sql.mjs supabase/auth-migration.sql",
    "db:migrate-users-to-auth": "node --env-file=.env.local --use-system-ca scripts/migrate-users-to-auth.mjs",
    "db:rls-authenticated": "node --env-file=.env.local scripts/run-sql.mjs supabase/rls-authenticated-policies.sql",
    "db:rls-drop-anon": "node --env-file=.env.local scripts/run-sql.mjs supabase/rls-drop-anon.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "postcss": "^8.4.38",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
